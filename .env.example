# Frontend (public values — safe for the browser)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# Only for scripts/seed.ts (never prefix with VITE_, never commit)
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>
# Optional: passwords for seeded demo users (otherwise defaults from the script are used)
SEED_PASSWORD=
